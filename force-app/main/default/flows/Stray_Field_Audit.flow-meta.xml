<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Screen flow that walks an admin through a quick "stray field" audit: pick an object, and the flow echoes the coverage checklist.</description>
    <interviewLabel>Stray Field Audit {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Stray Field Audit</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>ScreenFlow</processType>
    <assignments>
        <name>BuildAuditMessage</name>
        <label>Build Audit Message</label>
        <locationX>300</locationX>
        <locationY>200</locationY>
        <assignmentItems>
            <assignToReference>auditMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Auditing coverage for the selected object. Open Object Manager to review custom fields and data quality next.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <screens>
        <name>PickObjectToAudit</name>
        <label>Pick Object To Audit</label>
        <locationX>100</locationX>
        <locationY>200</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <fields>
            <name>ChooseObject</name>
            <label>Choose Object</label>
            <extensionName>c:flowRuntimeForScreenComponentsPicklist</extensionName>
            <fieldType>Picklist</fieldType>
            <inputVariable>
                <name>selectedObject</name>
                <dataType>String</dataType>
                <isCollection>false</isCollection>
                <isInput>true</isInput>
                <isOutput>true</isOutput>
            </inputVariable>
            <isRequired>true</isRequired>
            <choices>
                <name>ChoiceAccount</name>
                <label>Account</label>
                <choiceText>Account</choiceText>
                <value>
                    <stringValue>Account</stringValue>
                </value>
            </choices>
            <choices>
                <name>ChoiceContact</name>
                <label>Contact</label>
                <choiceText>Contact</choiceText>
                <value>
                    <stringValue>Contact</stringValue>
                </value>
            </choices>
            <choices>
                <name>ChoiceLead</name>
                <label>Lead</label>
                <choiceText>Lead</choiceText>
                <value>
                    <stringValue>Lead</stringValue>
                </value>
            </choices>
            <choices>
                <name>ChoiceCase</name>
                <label>Case</label>
                <choiceText>Case</choiceText>
                <value>
                    <stringValue>Case</stringValue>
                </value>
            </choices>
        </fields>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </start>
    <variables>
        <name>auditMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>selectedObject</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>