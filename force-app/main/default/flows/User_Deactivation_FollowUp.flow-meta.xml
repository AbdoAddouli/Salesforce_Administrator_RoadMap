<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>When a user is deactivated, creates a cleanup task so the admin fast-tracks ownership re-assignment and alias retrieval.</description>
    <interviewLabel>User Deactivation FollowUp {!$Flow.CurrentDateTime}</interviewLabel>
    <label>User Deactivation FollowUp</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>CreateDeactivationCleanupTask</name>
        <label>Create Deactivation Cleanup Task</label>
        <locationX>100</locationX>
        <locationY>200</locationY>
        <inputAssignments>
            <field>Name</field>
            <value>
                <stringValue>Deactivation Cleanup</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority__c</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <object>Admin_Task__c</object>
    </recordCreates>
    <start>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <recordTriggerType>AfterSave</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
</Flow>